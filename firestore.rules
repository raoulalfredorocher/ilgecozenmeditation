rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Regole di sicurezza Firestore — Il Geco Zen
//
// Principio: ogni utente vede e modifica SOLO i propri dati, che vivono
// sotto users/{uid}/... . Tutto ciò che non è esplicitamente permesso
// qui sotto è negato.
//
// In più si accettano solo le collezioni che l'app usa davvero: un utente
// autenticato non può creare collezioni arbitrarie nel proprio spazio.
// Quando aggiungi una nuova sezione all'app, aggiungi qui il nome della
// sua collezione (vedi docs/SICUREZZA.md).
//
// Deploy: firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }


    // ── Servizio di sincronizzazione dell'orologio (scripts/sync_zepp.py, GitHub Actions) ──
    // Accede con un utente dedicato (zepp-sync@…), NON con una chiave di amministratore.
    // Può soltanto: leggere il registro degli allenamenti, aggiungervi sessioni "Dall'orologio",
    // aggiornarne i campi dell'orologio (kcal, battiti) e scrivere i dati del giorno. Non cancella
    // niente e non vede nessun'altra parte dell'app, anche se le sue credenziali venissero rubate.
    function isZeppSync() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'zepp-sync@ilgecozen-b2df7.firebaseapp.com';
    }

    match /users/{uid}/direction/salute_giorni {
      allow create, update: if isZeppSync();
    }

    match /users/{uid}/allenamenti_registro/{id} {
      allow read: if isZeppSync();
      allow create: if isZeppSync()
        && request.resource.data.hk is string && request.resource.data.hk.matches('zepp:.*')
        && request.resource.data.orologio is string;
      allow update: if isZeppSync()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kcal', 'bpmMedio', 'bpmMax', 'orologio', 'hk']);
    }

    // Collezioni di primo livello sotto users/{uid}/
    function isKnownCollection(col) {
      return col in [
        // Meditazione
        'meditation_sessions',
        // Alimentazione
        'recipes', 'food_diary', 'diet', 'saved_diets', 'macros', 'shopping_stores',
        // Allenamento
        'allenamenti_piani', 'allenamenti_registro',
        // Bucket list, direzione, salute mentale
        'bucket_list', 'direction', 'salute_mentale', 'mental_diary',
        'emozioni_log', 'emozioni_entries',
        // Passioni
        'libri', 'film', 'giochi', 'giochi_tavolo', 'musica_accordi', 'musica_media',
        'countries',
        // Armonia sociale, finanza, personal brand
        'crm_contacts',
        'finanza_accounts', 'finanza_categories', 'finanza_expenses',
        'guardaroba', 'igiene_actions', 'ispirazione',
        // Diagnostica tecnica dei dispositivi (js/core/telemetry.js)
        'debug_logs'
      ];
    }

    // Ogni documento delle collezioni note (comprese le sotto-collezioni
    // come trips, partite, items, log, dettagli_chunks) è accessibile solo
    // al proprietario.
    match /users/{uid}/{col}/{rest=**} {
      allow read, write: if isOwner(uid) && isKnownCollection(col);
    }
  }
}
